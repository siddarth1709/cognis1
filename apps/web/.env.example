# Cognis Authentication Secrets
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Deployed AWS HTTP API base URL (for example, https://abc.execute-api.region.amazonaws.com)
COGNIS_API_URL=
# Server-only key for the deployed Cognis API. Never prefix this with NEXT_PUBLIC_.
COGNIS_API_KEY=

# OAuth Providers
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# GitHub OAuth callback: http://localhost:3000/api/github/callback
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
